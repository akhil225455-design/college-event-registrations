# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string, or mongodb://127.0.0.1:27017/college-events for a local database
MONGODB_URI=mongodb+srv://akhil225455_db_user:Akhil123@cluster0.vrzvmza.mongodb.net/

# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed to call this API, comma separated
CLIENT_ORIGIN=http://localhost:5173

# Used only by `npm run seed` to create the first admin account
ADMIN_NAME=Event Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
